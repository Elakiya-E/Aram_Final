# ---------------------------------------------------------------------------
# Aram Analytics - environment configuration
# ---------------------------------------------------------------------------

# Inbox shown by the "contact" call-to-action links elsewhere on the site.
# This is public (shipped to the browser) and only ever used for mailto links.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Project Brief form delivery (server-side only)
# ---------------------------------------------------------------------------
# These values are read by the PHP endpoint that ships with the static build:
#   public/api/send-enquiry.php
#
# They are NOT used by Next.js and must never be prefixed with NEXT_PUBLIC_.
#
# On the server, provide them either as real environment variables or place a
# copy of this file named `.env` next to the endpoint:
#   public/api/.env          (created on the host, excluded from Git)
#
# Nothing below belongs in client-side code. Keep real values out of the repo.

# Recipient of every submitted enquiry (fixed - visitors cannot change it).
ENQUIRY_TO_EMAIL=aramanalytics2025@gmail.com

# SMTP transport
#   smtp.gmail.com + 465 + ssl  -> Gmail with a Google App Password
#   smtp.gmail.com + 587 + tls  -> Gmail via STARTTLS
#   mail.yourdomain.com + 465   -> Hostinger mailbox
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
# ssl (implicit TLS) | tls (STARTTLS) | none
SMTP_SECURE=ssl
SMTP_USER=your_smtp_username
# For Gmail, use a 16-character Google App Password - not your account password.
SMTP_PASS=your_smtp_password

# Optional: override the visible sender and the timestamp timezone.
SMTP_FROM=your_smtp_username
SMTP_FROM_NAME=Aram Analytics Website
ENQUIRY_TIMEZONE=Asia/Kolkata
